---
import { locales, getHrefLang, getContent } from "../i18n";

export interface Props {
  page: string;
}

const { page } = Astro.props;
const locale = Astro.currentLocale || "en";
const content = getContent(locale);
if (!content) throw new Error(`Missing i18n content for locale: ${locale}`);

const navItems = [
  { key: "home", href: locale === "en" ? "/" : `/${locale}/` },
  { key: "about", href: locale === "en" ? "/about/" : `/${locale}/about/` },
  {
    key: "contact",
    href: locale === "en" ? "/contact/" : `/${locale}/contact/`,
  },
  {
    key: "terms",
    href: locale === "en" ? "/terms/" : `/${locale}/terms/`,
  },
  {
    key: "privacy",
    href: locale === "en" ? "/privacy/" : `/${locale}/privacy/`,
  },
] as const;

const url = new URL(Astro.url);
const pathParts = url.pathname.split("/").filter(Boolean);
const pagePath =
  locale === "en" ? url.pathname : "/" + pathParts.slice(1).join("/");
const normalizedPagePath =
  pagePath === "/"
    ? "/"
    : pagePath.endsWith("/")
      ? pagePath
      : pagePath + "/";
---

<nav
  class="sticky top-0 z-50 h-14 border-b border-gray-200 bg-white/80 backdrop-blur-md dark:border-hairline dark:bg-canvas/80"
>
  <div
    class="mx-auto flex h-full max-w-6xl items-center justify-between px-4 sm:px-6"
  >
    <a
      href={locale === "en" ? "/" : `/${locale}/`}
      class="text-sm font-semibold tracking-tight text-gray-900 no-underline dark:text-ink"
    >
      {content.layout.title}
    </a>

    <div class="flex items-center gap-2 sm:hidden">
      <button
        id="dark-toggle-mobile"
        class="flex size-8 items-center justify-center rounded-full text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-surface-1"
        aria-label="Toggle dark mode"
      >
        <svg class="size-5 dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
        <svg class="hidden size-5 dark:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
      </button>
      <button
        id="menu-toggle"
        class="flex size-8 items-center justify-center rounded-full text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-surface-1"
        aria-label="Toggle menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

    <div id="nav-menu" class="hidden sm:flex sm:items-center sm:gap-6">
      <ul class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-6">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "inline-block rounded-pill px-3 py-1.5 text-sm font-medium no-underline transition-colors",
                item.key === page
                  ? "bg-gray-900 text-white dark:bg-surface-2 dark:text-ink"
                  : "text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-surface-1 dark:hover:text-ink",
              ]}
            >
              {content.nav[item.key]}
            </a>
          </li>
        ))}
      </ul>

      <div class="ml-2 flex items-center gap-1 border-l border-gray-200 pl-4 dark:border-hairline">
        {locales.map((l) => (
          <a
            href={
              l === "en"
                ? normalizedPagePath
                : `/${l}${normalizedPagePath}`
            }
            class:list={[
              "rounded-pill px-2 py-1 text-xs font-semibold uppercase no-underline transition-colors",
              l === locale
                ? "bg-gray-900 text-white dark:bg-ink dark:text-canvas"
                : "text-gray-500 hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-surface-1 dark:hover:text-ink",
            ]}
            aria-label={getHrefLang(l)}
          >
            {l}
          </a>
        ))}
      </div>

      <button
        id="dark-toggle"
        class="ml-2 flex size-8 items-center justify-center rounded-full text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-surface-1"
        aria-label="Toggle dark mode"
      >
        <svg class="size-5 dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
        <svg class="hidden size-5 dark:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  function toggleDark() {
    const html = document.documentElement;
    html.classList.toggle("dark");
    localStorage.setItem("theme", html.classList.contains("dark") ? "dark" : "light");
  }

  document.getElementById("dark-toggle")?.addEventListener("click", toggleDark);
  document.getElementById("dark-toggle-mobile")?.addEventListener("click", toggleDark);
  document.getElementById("menu-toggle")?.addEventListener("click", () => {
    document.getElementById("nav-menu")?.classList.toggle("hidden");
  });
</script>
