---
import { locales, getHrefLang, getContent } from "../i18n";

const locale = Astro.currentLocale || "en";
const content = getContent(locale);
if (!content) throw new Error(`Missing i18n content for locale: ${locale}`);
---

<footer
  class="border-t border-gray-200 bg-gray-50 dark:border-hairline-soft dark:bg-canvas"
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-12 sm:flex-row sm:justify-between sm:py-16 sm:px-6"
  >
    <p class="text-caption letter-spacing-caption text-gray-500 dark:text-ink-muted">
      {content.footer.text}
    </p>

    <div class="flex flex-wrap items-center gap-3">
      <span class="text-caption letter-spacing-caption font-medium uppercase text-gray-400 dark:text-ink-muted">
        Lang:
      </span>
      {locales.map((l) => (
        <a
          href={l === "en" ? "/" : `/${l}/`}
          class:list={[
            "rounded-pill px-2 py-1 text-xs font-semibold uppercase no-underline transition-colors",
            l === locale
              ? "bg-gray-900 text-white dark:bg-ink dark:text-canvas"
              : "text-gray-500 hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-surface-1 dark:hover:text-ink",
          ]}
          aria-label={getHrefLang(l)}
        >
          {l}
        </a>
      ))}
    </div>
  </div>
</footer>
