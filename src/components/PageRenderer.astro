---
export interface Props {
  page: string;
  content: {
    title: string;
    content?: string;
    description?: string;
    cta?: string;
    email?: string;
    phone?: string;
    updated?: string;
  };
}

const { page, content } = Astro.props;
---

{page === "home" && (
  <section class="page home">
    <h1 class="text-[32px] font-bold tracking-tight text-gray-900 dark:text-ink dark:md:text-display-md dark:lg:text-display-lg dark:xl:text-display-xl dark:2xl:text-display-xxl">
      {content.title}
    </h1>
    <p class="mt-4 text-body-lg letter-spacing-body-lg text-gray-600 dark:text-ink-muted">
      {content.description}
    </p>
  </section>
)}

{page === "about" && (
  <section class="page about">
    <h1 class="text-display-md letter-spacing-display-md text-gray-900 dark:text-ink">
      {content.title}
    </h1>
    <p class="mt-4 text-body letter-spacing-body text-gray-600 dark:text-ink-muted">
      {content.content}
    </p>
  </section>
)}

{page === "contact" && (
  <section class="page contact">
    <h1 class="text-display-md letter-spacing-display-md text-gray-900 dark:text-ink">
      {content.title}
    </h1>
    <p class="mt-4 text-body letter-spacing-body text-gray-600 dark:text-ink-muted">
      {content.content}
    </p>
    {content.email && (
      <p class="mt-4 text-body letter-spacing-body text-gray-600 dark:text-ink-muted">
        <strong>Email:</strong>{" "}
        <a
          href={`mailto:${content.email}`}
          class="text-accent-blue no-underline hover:underline"
        >
          {content.email}
        </a>
      </p>
    )}
    {content.phone && (
      <p class="mt-4 text-body letter-spacing-body text-gray-600 dark:text-ink-muted">
        <strong>Phone:</strong> {content.phone}
      </p>
    )}
  </section>
)}

{page === "terms" && (
  <section class="page terms">
    <h1 class="text-display-md letter-spacing-display-md text-gray-900 dark:text-ink">
      {content.title}
    </h1>
    {content.updated && (
      <p class="mt-2 text-caption letter-spacing-caption text-gray-500 dark:text-ink-muted">
        {content.updated}
      </p>
    )}
    <p class="mt-4 text-body letter-spacing-body text-gray-600 dark:text-ink-muted">
      {content.content}
    </p>
  </section>
)}

{page === "privacy" && (
  <section class="page privacy">
    <h1 class="text-display-md letter-spacing-display-md text-gray-900 dark:text-ink">
      {content.title}
    </h1>
    {content.updated && (
      <p class="mt-2 text-caption letter-spacing-caption text-gray-500 dark:text-ink-muted">
        {content.updated}
      </p>
    )}
    <p class="mt-4 text-body letter-spacing-body text-gray-600 dark:text-ink-muted">
      {content.content}
    </p>
  </section>
)}

<style>
  .page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem 2rem;
  }
</style>
